# Start from the distro linux-asahi config and overlay only the experimental
# dock features.  Keeping the distro choices intact preserves the known-good
# 16K/48-bit memory layout, EFI framebuffer, and built-in Apple boot drivers.
CONFIG_LOCALVERSION="-j414c-dock5"
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
CONFIG_TYPEC_TBT_ALTMODE=m
CONFIG_RESET_APPLE_CIO=y
CONFIG_DRM_ASAHI=m

# The forward-ported Asahi GPU driver does not yet have a safe teardown path.
# Keep it modular so recovery can blacklist it, but make unloading impossible
# in this dedicated test kernel.  The driver also suppresses its sysfs bind
# attributes, closing the other normal userspace-triggered unbind path.
# CONFIG_MODULE_UNLOAD is not set

# This U-Boot build exposes only a volatile EFI variable store.  Keep the
# distro pstore policy unchanged rather than writing a verbose boot log into a
# backend that cannot survive the recovery reboot.  The diagnostic boot uses
# EFI framebuffer earlycon and keeps the boot console visible instead.
CONFIG_PSTORE=y
# CONFIG_PSTORE_CONSOLE is not set
# CONFIG_PSTORE_PMSG is not set
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y
