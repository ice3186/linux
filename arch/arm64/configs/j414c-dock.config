# Start from the distro linux-asahi config and overlay only the experimental
# dock features.  Keeping the distro choices intact preserves the known-good
# 16K/48-bit memory layout, EFI framebuffer, and built-in Apple boot drivers.
CONFIG_LOCALVERSION="-j414c-dock3"
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
CONFIG_TYPEC_TBT_ALTMODE=m
CONFIG_RESET_APPLE_CIO=y

# Preserve early boot output across a failed one-shot test when EFI pstore is
# available.  Command-line options enable the backend for the diagnostic boot.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_EFI_VARS_PSTORE=y
# CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE is not set
